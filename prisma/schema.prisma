generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum ContactStatus {
  READY
  PROCESSING
  CONTACTED
  RESPONDED
  OPTED_IN
  OPTED_OUT
  BLOCKED
  INVALID
}

enum CampaignStatus {
  DRAFT
  GENERATING
  READY_FOR_REVIEW
  APPROVED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum MessageStatus {
  PENDING
  GENERATING
  GENERATED
  APPROVED
  REJECTED
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum InstanceStatus {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  CONNECTED
  ERROR
}

enum AuditAction {
  USER_REGISTER
  USER_LOGIN
  FILE_UPLOADED
  CONTACT_IMPORTED
  CAMPAIGN_CREATED
  AI_MESSAGE_GENERATED
  MESSAGE_EDITED
  MESSAGE_APPROVED
  CAMPAIGN_APPROVED
  CAMPAIGN_STARTED
  CAMPAIGN_PAUSED
  CAMPAIGN_RESUMED
  CAMPAIGN_STOPPED
  CAMPAIGN_COMPLETED
  MESSAGE_SENT
  MESSAGE_FAILED
  WHATSAPP_CONNECTED
  WHATSAPP_DISCONNECTED
}

// ---------- Auth.js models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  contacts         Contact[]
  campaigns        Campaign[]
  whatsapp         WhatsAppInstance[]
  auditLogs        AuditLog[]
  importBatches    ImportBatch[]
  contactGroups    ContactGroup[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain models ----------

model Contact {
  id           String        @id @default(cuid())
  userId       String
  name         String
  businessName String
  phone        String        // normalized digits, e.g. 919876543210
  businessWork String
  status       ContactStatus @default(READY)
  importSource String?       // filename
  importBatchId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  campaigns   CampaignContact[]
  messages    Message[]
  groups      ContactGroupMember[]

  @@unique([userId, phone])
  @@index([userId, status])
  @@index([userId, phone])
  @@index([importBatchId])
}

model ImportBatch {
  id             String   @id @default(cuid())
  userId         String
  fileName       String
  totalRows      Int      @default(0)
  validRows      Int      @default(0)
  invalidRows    Int      @default(0)
  duplicateRows  Int      @default(0)
  importedRows   Int      @default(0)
  errors         Json?
  createdAt      DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@index([userId, createdAt])
}

model ContactGroup {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  members ContactGroupMember[]

  @@unique([userId, name])
  @@index([userId])
}

model ContactGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime @default(now())

  group   ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
}

model Campaign {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?        @db.Text
  objective   String         @db.Text
  tone        String         @default("Professional and friendly")
  language    String         @default("English")
  cta         String         @db.Text
  status      CampaignStatus @default(DRAFT)

  messagesPerBatch   Int @default(20)
  delayBetweenMs     Int @default(2000)
  maxMessages        Int @default(1000)
  maxRetries         Int @default(3)

  totalContacts Int @default(0)
  sentCount     Int @default(0)
  deliveredCount Int @default(0)
  readCount     Int @default(0)
  failedCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  completedAt DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets  CampaignContact[]
  messages Message[]
  auditLogs AuditLog[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model CampaignContact {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
}

model Message {
  id               String        @id @default(cuid())
  campaignId       String
  contactId        String
  phone            String
  generatedBody    String?       @db.Text
  finalBody        String?       @db.Text
  status           MessageStatus @default(PENDING)
  attempts         Int           @default(0)
  evolutionMessageId String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  failedAt         DateTime?
  failureReason    String?       @db.Text
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([evolutionMessageId])
  @@index([status, updatedAt])
}

model WhatsAppInstance {
  id          String         @id @default(cuid())
  userId      String
  name        String         // Evolution instance name
  phone       String?
  status      InstanceStatus @default(DISCONNECTED)
  qrCode      String?        @db.Text
  pairingCode String?
  lastConnectedAt DateTime?
  lastError   String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, status])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String?  // Evolution event/message id for dedupe
  event       String
  instance    String?
  payload     Json
  processed   Boolean  @default(false)
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([eventId, event])
  @@index([processed, createdAt])
  @@index([event])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  campaignId String?
  action     AuditAction
  metadata   Json?
  createdAt  DateTime    @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
  @@index([action, createdAt])
}
